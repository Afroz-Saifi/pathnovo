# ─────────────────────────────────────────────────────────────
# LLM — the only external service. NEVER commit a real key.
# Swap provider by changing LLM_PROVIDER + the model vars.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
CONTEXT_TOKEN_BUDGET=16000
HISTORY_MAX_TURNS=6
RUN_TOKEN_CEILING=60000

# ─────────────────────────────────────────────────────────────
# Database (Postgres + pgvector) — used from slice 2 onward.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathnovo

# ─────────────────────────────────────────────────────────────
# Ingestion
# ─────────────────────────────────────────────────────────────
SCANNED_TEXT_THRESHOLD=50
OCR_DPI=300
OCR_LANG=eng
VISION_ASSIST=on
VISION_ASSIST_THRESHOLD=0.60
VISION_MAX_CROPS_PER_SHEET=12

# ─────────────────────────────────────────────────────────────
# Delta engine (all deterministic; snapshot stored per comparison)
# ─────────────────────────────────────────────────────────────
MATCH_THRESHOLD=0.55
MOVE_TOLERANCE=0.008
W_TEXT=0.50
W_SPATIAL=0.35
W_KIND=0.15
ANCHOR_MIN_PAIRS=4
ENRICH=on

# ─────────────────────────────────────────────────────────────
# Retrieval (grounded chat)
# ─────────────────────────────────────────────────────────────
CHUNK_TARGET_CHARS=300
VECTOR_TOP=20
FTS_TOP=20
RRF_K=60
RETRIEVAL_K=8
