// Pathnovo data model. Single Postgres store for documents, comparisons, the
// structured delta, and the whole observability system (runs / trace_events /
// usage_events). pgvector columns for retrieval land in a later slice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id            String   @id @default(cuid())
  pid           String
  format        String
  revisionLabel String?
  filename      String
  sha256        String
  pageCount     Int
  canonical     Json
  warnings      Json
  createdAt     DateTime @default(now())

  @@index([pid])
  @@map("documents")
}

model Comparison {
  id             String        @id
  pidA           String
  pidB           String
  status         String        @default("complete")
  registration   Json
  configSnapshot Json
  summary        Json
  // Source PDFs, kept so sheets can be rendered for the overlay view.
  pdfA           Bytes?
  pdfB           Bytes?
  entries        DeltaEntry[]
  chunks         Chunk[]
  chatSessions   ChatSession[]
  createdAt      DateTime      @default(now())

  @@map("comparisons")
}

// Retrieval chunk. Embedding stored as a plain float array; at this scale
// (tens of chunks per comparison) hybrid retrieval runs in-process. pgvector
// is the drop-in for larger corpora.
model Chunk {
  id           String     @id @default(cuid())
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  sourceType   String // pidA | pidB | delta
  sheet        Int?
  text         String
  refs         Json
  embedding    Float[]
  createdAt    DateTime   @default(now())

  @@index([comparisonId])
  @@map("chunks")
}

model ChatSession {
  id           String        @id @default(cuid())
  comparisonId String
  comparison   Comparison    @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  // Cursor for paginated enumeration ("show more").
  enumType     String?
  enumOffset   Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([comparisonId])
  @@map("chat_sessions")
}

// Runtime config overrides (env-var-keyed), merged over process.env on load.
model AppConfig {
  id        String   @id @default("singleton")
  overrides Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String // user | assistant
  content    String
  citations  Json?
  confidence String?
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model DeltaEntry {
  id           String     @id
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  changeType   String
  modifyKind   String?
  itemKind     String
  sheet        Int
  bboxA        Json?
  bboxB        Json?
  textA        String?
  textB        String?
  description  String
  confidence   Float

  @@index([comparisonId])
  @@map("delta_entries")
}

// ── Observability ──────────────────────────────────────────────────────────

model Run {
  id           String       @id @default(cuid())
  kind         String // ingest | delta | chat | eval
  status       String       @default("running") // running | ok | failed
  requestId    String
  pidA         String?
  pidB         String?
  comparisonId String?
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  error        String?
  traceEvents  TraceEvent[]
  usageEvents  UsageEvent[]

  @@index([kind, startedAt])
  @@map("runs")
}

model TraceEvent {
  id            String   @id @default(cuid())
  runId         String
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence      Int
  parentEventId String?
  eventType     String
  attributes    Json
  tsStart       DateTime @default(now())
  durationMs    Int?

  @@unique([runId, sequence])
  @@index([runId, sequence])
  @@map("trace_events")
}

model UsageEvent {
  id           String  @id @default(cuid())
  runId        String
  run          Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  traceEventId String?
  provider     String
  model        String
  inputTokens  Int     @default(0)
  cachedTokens Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)

  @@index([runId])
  @@map("usage_events")
}
